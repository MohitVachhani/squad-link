# Postgres (Supabase session pooler, IPv4). Keep the +asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Random secret for signing auth JWTs: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Where the React app runs (CORS + OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Only needed for `make download`
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=   # KGAT_... token (older kaggle.json keys go in KAGGLE_KEY instead)
# Serverless deploys (Vercel) only: true + the transaction pooler (port 6543) in DATABASE_URL
DB_SERVERLESS=false
# Only needed for `make deploy` (Vercel > Account Settings > Tokens); otherwise `vercel login` is used
VERCEL_TOKEN=
